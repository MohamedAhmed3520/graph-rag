# OpenRouter Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=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
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LLM Model Configuration
# Visit https://openrouter.ai/docs/models for available models
LLM_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.2

# Embedding Model
# Pre-trained Sentence Transformer model (runs locally)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Neo4j Configuration (Optional - Hybrid Graph+Vector RAG)
# If Neo4j is not running or unavailable, the system will fall back to Vector-only RAG
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=e0dc1c41
NEO4J_PASSWORD=O-PuOyhSJEOtCtbK9A6Ck2nE7qrzClcj1wCbP2TANqc

# FAISS Vector Database Paths (Local file storage)
FAISS_INDEX_PATH=data/processed/faiss.index
FAISS_DOCSTORE_PATH=data/processed/docstore.json

# Document Chunking Configuration
# These control how documents are split into smaller chunks for embedding
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Retrieval Configuration
# Number of chunks to retrieve per query
RETRIEVAL_TOP_K=6
# Minimum similarity score (0.0-1.0) for vector retrieval results
SIMILARITY_THRESHOLD=0.2
# Maximum Marginal Relevance (MMR) balancing factor
MMR_LAMBDA=0.5

# ========== For Streamlit Cloud Deployment ==========
# Instead of .env, create a Streamlit secret at:
# https://share.streamlit.io/settings/secrets
# and set these keys in the Streamlit Cloud secrets manager:
#   OPENROUTER_API_KEY
#   NEO4J_URI (optional)
#   NEO4J_USERNAME (optional)
#   NEO4J_PASSWORD (optional)

