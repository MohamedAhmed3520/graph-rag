# ---------------------------------------------------------------------------
# Copy this file to `.env` for LOCAL development:
#     cp .env.example .env
#
# On Streamlit Cloud do NOT commit a `.env`. Instead set these in
# App settings -> Secrets (they take precedence over `.env`):
#     OPENROUTER_API_KEY = "sk-or-v1-..."
#
# Get an OpenRouter key from https://openrouter.ai/keys
# ---------------------------------------------------------------------------

# OpenRouter Configuration
OPENROUTER_API_KEY=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
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LLM Model Configuration (https://openrouter.ai/models)
LLM_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.2

# Embedding Model (runs locally via sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Neo4j Configuration (Optional - falls back to Vector-only RAG if unavailable)
NEO4J_URI=neo4j+s://d2ee97bc.databases.neo4j.io
NEO4J_USERNAME=d2ee97bc
NEO4J_PASSWORD=22xI4ag-h-OCtKnIxTO9aE7-uWacZ2DBGcl0yLHKwBk
NEO4J_DATABASE=d2ee97bc
AURA_INSTANCEID=d2ee97bc
AURA_INSTANCENAME=Instance01

# FAISS Vector Database paths
FAISS_INDEX_PATH=data/processed/faiss.index
FAISS_DOCSTORE_PATH=data/processed/docstore.json

# Document chunking
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Retrieval
RETRIEVAL_TOP_K=6
SIMILARITY_THRESHOLD=0.2
MMR_LAMBDA=0.5
